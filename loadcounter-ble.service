[Unit]
Description=Load Counter BLE Remote Control
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/jul/loadcounter
ExecStart=/home/jul/loadcounter/env/bin/python /home/jul/loadcounter/loadcounter-ble.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loadcounter-ble

[Install]
WantedBy=multi-user.target
